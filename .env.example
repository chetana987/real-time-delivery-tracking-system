# Copy this file to .env and adjust the values.
# Never commit the real .env file; keep it out of version control.

# ---------------- Backend ----------------
# JWT signing secret (HS256, must be at least 32 bytes). Generate one with:
#   openssl rand -hex 32
JWT_SECRET=change-me-please-use-a-long-random-secret-32b+
JWT_EXPIRATION_MS=86400000
PARTNER_SEARCH_RADIUS_KM=10
LOCATION_UPDATE_MIN_INTERVAL_SECONDS=2

# ---------------- MySQL ----------------
MYSQL_DB=delivery_tracking
MYSQL_USER=delivery
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# ---------------- Redis ----------------
REDIS_PASSWORD=change-me
